# ---------------------------------------------------------------------------
# Banco de dados
# ---------------------------------------------------------------------------

POSTGRES_DB=automata
POSTGRES_USER=automata
POSTGRES_PASSWORD=            # defina antes de subir o compose

# SERVER-ONLY: string de conexão usada pela API; nunca exposta ao browser
# O driver precisa ser explícito: postgresql:// sozinho resolve para psycopg2,
# que não é dependência do projeto — o projeto usa psycopg 3
DATABASE_URL=postgresql+psycopg://automata:<password>@db:5432/automata

# ---------------------------------------------------------------------------
# JWT — RS256 assimétrico (ADR-0005)
# ---------------------------------------------------------------------------

# SERVER-ONLY: chave privada RSA usada SOMENTE pela API para emitir tokens.
# Nunca vai ao container web nem ao Vercel: o painel só verifica (chave pública).
# Geração: openssl genrsa 2048 | awk 'NF {sub(/\r/, ""); printf "%s\\n",$0}'
JWT_PRIVATE_KEY=

# Chave pública correspondente; usada pela API e pelo proxy do painel para
# verificar tokens. Pode ir para os containers `api` e `web`.
# Extração: openssl rsa -pubout 2>/dev/null | awk 'NF {sub(/\r/, ""); printf "%s\\n",$0}'
JWT_PUBLIC_KEY=

# IPs ou CIDRs dos proxies na frente da API cujo X-Forwarded-For é confiável
# (separados por vírgula). Vazio: o header é ignorado e o rate limit do login
# usa o IP da conexão. Só inclua uma rede se a API não for alcançável por fora
# dela — do contrário qualquer cliente forja o IP.
# Ex. compose sem porta 8000 publicada: TRUSTED_PROXIES=172.16.0.0/12
TRUSTED_PROXIES=

# ---------------------------------------------------------------------------
# Web (Next.js)
# ---------------------------------------------------------------------------

# URL da API acessível pelo container web (docker-compose) ou pelo servidor Next.js.
# Em compose: http://api:8000 — Em dev local: http://localhost:8000
AUTOMATA_API_URL=http://localhost:8000
