# ---------------------------------------------------------------------------
# Banco de dados
# ---------------------------------------------------------------------------

POSTGRES_DB=automata
POSTGRES_USER=automata
POSTGRES_PASSWORD=            # defina antes de subir o compose

# SERVER-ONLY: string de conexão usada pela API; nunca exposta ao browser
# O driver precisa ser explícito: postgresql:// sozinho resolve para psycopg2,
# que não é dependência do projeto — o projeto usa psycopg 3
DATABASE_URL=postgresql+psycopg://automata:<password>@db:5432/automata

# ---------------------------------------------------------------------------
# JWT — RS256 assimétrico (ADR-0005)
# ---------------------------------------------------------------------------

# SERVER-ONLY: chave privada RSA usada SOMENTE pela API para emitir tokens.
# Nunca vai ao container web nem ao Vercel: o painel só verifica (chave pública).
# Geração: openssl genrsa 2048 | awk 'NF {sub(/\r/, ""); printf "%s\\n",$0}'
JWT_PRIVATE_KEY=

# Chave pública correspondente; usada pela API e pelo proxy do painel para
# verificar tokens. Pode ir para os containers `api` e `web`.
# Extração: openssl rsa -pubout 2>/dev/null | awk 'NF {sub(/\r/, ""); printf "%s\\n",$0}'
JWT_PUBLIC_KEY=

# IPs ou CIDRs dos proxies na frente da API cujo X-Forwarded-For é confiável
# (separados por vírgula). Vazio: o header é ignorado e o rate limit do login
# usa o IP da conexão. Só inclua uma rede se a API não for alcançável por fora
# dela — do contrário qualquer cliente forja o IP. O X-Forwarded-Proto desses
# proxies também vale: com "https", a API envia Strict-Transport-Security.
# Ex. compose sem porta 8000 publicada: TRUSTED_PROXIES=172.16.0.0/12
TRUSTED_PROXIES=

# "development" liga /docs, /redoc e /openapi.json na API. Padrão: production
# (desligados). O docker-compose.dev.yml já define development.
APP_ENV=production

# ---------------------------------------------------------------------------
# Servidores MCP externos (ADR-0010)
# ---------------------------------------------------------------------------

# SERVER-ONLY: chave Fernet que cifra os headers (tokens) dos servidores MCP.
# Obrigatória para cadastrar servidor com header. Perder a chave obriga a
# recadastrar os segredos.
# Geração: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MCP_SECRETS_KEY=

# Hosts liberados da checagem de rede interna (separados por vírgula). Só para
# servidores MCP que rodam na rede da própria instância; aceita http.
MCP_ALLOWED_HOSTS=

# URL pública da API. Usada para montar o endereço do /mcp entregue junto com
# os tokens de integração (ex.: https://api.suaempresa.com).
PUBLIC_BASE_URL=

# Grava spans de agente, time, modelo e tool para a árvore de execução do painel
TRACING_ENABLED=true

# ---------------------------------------------------------------------------
# Web (Next.js)
# ---------------------------------------------------------------------------

# URL da API usada pelo `pnpm --filter web dev` no host. O container web dos
# compose usa http://api:8000 fixo (a porta 8000 só é publicada no override de dev).
AUTOMATA_API_URL=http://localhost:8000
