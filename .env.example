# ---------------------------------------------------------------------------
# Banco de dados
# ---------------------------------------------------------------------------

POSTGRES_DB=automata
POSTGRES_USER=automata
POSTGRES_PASSWORD=            # defina antes de subir o compose

# SERVER-ONLY: string de conexão usada pela API; nunca exposta ao browser
DATABASE_URL=postgresql://automata:<password>@db:5432/automata

# ---------------------------------------------------------------------------
# JWT — RS256 assimétrico (ADR-0005)
# ---------------------------------------------------------------------------

# SERVER-ONLY: chave privada RSA usada pela API para emitir tokens e pelo
# processo Next.js (BFF) para assinar cookies. NUNCA vai ao browser.
# Geração: openssl genrsa 2048 | awk 'NF {sub(/\r/, ""); printf "%s\\n",$0}'
# Passada apenas para o container `api` no Docker; o Next.js a lê via
# variável de ambiente do processo Node (ex: .env.local), não via Docker env.
JWT_PRIVATE_KEY=

# Chave pública correspondente; usada pelo AgentOS para verificar tokens.
# Pode ser passada ao container `api` sem restrição adicional.
# Extração: openssl rsa -pubout 2>/dev/null | awk 'NF {sub(/\r/, ""); printf "%s\\n",$0}'
JWT_PUBLIC_KEY=

# ---------------------------------------------------------------------------
# Web (Next.js)
# ---------------------------------------------------------------------------

# URL da API acessível pelo container web (docker-compose) ou pelo servidor Next.js.
# Em compose: http://api:8000 — Em dev local: http://localhost:8000
AUTOMATA_API_URL=http://localhost:8000
