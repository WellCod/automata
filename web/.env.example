# URL do servidor FastAPI/AgentOS
AUTOMATA_API_URL=http://localhost:8000

# Chave PÚBLICA RSA (PEM) da API. O proxy (src/proxy.ts) só verifica o JWT;
# quem emite é a API. A chave privada nunca entra no processo web.
# Extração: openssl rsa -in chave.pem -pubout
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----
...
-----END PUBLIC KEY-----"

# Chave pública anterior, só durante a troca do par (ADR-0026). Vazia fora da rotação
JWT_PREVIOUS_PUBLIC_KEY=

# Audiência do JWT (deve bater com a emitida pela API)
JWT_AUDIENCE=automata
