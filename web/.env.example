# URL do servidor FastAPI/AgentOS
AUTOMATA_API_URL=http://localhost:8000

# Chave privada RSA (PEM) para emissão de JWT no BFF.
# NUNCA prefixe com NEXT_PUBLIC_ — esta chave não deve chegar ao browser.
# Gere com: openssl genrsa 2048 | openssl pkcs8 -topk8 -nocrypt
JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----
...
-----END PRIVATE KEY-----"

# Audiência do JWT (deve bater com JWT_AUDIENCE configurado na API)
JWT_AUDIENCE=automata

# ID do usuário embutido nos tokens emitidos pelo painel
PANEL_USER_ID=panel
